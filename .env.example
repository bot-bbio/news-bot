# news-bot email newsletter integration configuration
# Copy this file to '.env' and fill in your credentials to enable secure, local IMAP email polling.
# DO NOT COMMIT YOUR ACTUAL '.env' FILE. It is already added to '.gitignore'.

# IMAP Server settings (e.g. imap.gmail.com for Gmail, outlook.office365.com for Outlook)
EMAIL_IMAP_SERVER=imap.gmail.com

# Your email address
EMAIL_ADDRESS=your.email@gmail.com

# Your App Password (do NOT use your account password. For Gmail, generate an "App Password" in Security settings)
EMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Email folder/label to read from (default is "INBOX" or "Newsletters")
# It is recommended to create a filter in your mail client that automatically moves 
# Zitron/Levine emails to a custom folder (e.g., "Newsletters") and enter that folder name here.
EMAIL_FOLDER=INBOX
